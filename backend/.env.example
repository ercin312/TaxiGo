APP_NAME=TaxiGo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
TAXIGO_SUPPORT_EMAIL=destek@taxigo.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=taxigo
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Firebase (required for RTDB + FCM in production) ---
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=taxigo-e7b4b
FIREBASE_CREDENTIALS=storage/app/firebase-service-account.json
# Example: https://taxigo-e7b4b-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=
FIREBASE_DATABASE_SECRET=

GOOGLE_MAPS_API_KEY=

# --- Auth / WhatsApp OTP ---
# local: log | staging/prod WhatsApp: whatsapp
TAXIGO_SMS_DRIVER=log
TAXIGO_SMS_MESSAGE="TaxiGo login code: :code"
TAXIGO_SMS_WEBHOOK_URL=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# false in production (also controlled by Super Admin modules.demo_login)
TAXIGO_DEMO_LOGIN=true
TAXIGO_SOS_WEBHOOK_URL=
TAXIGO_SOS_NOTIFY_ADMINS=true
TAXIGO_OTP_MAX_ATTEMPTS=5
TAXIGO_OTP_PUSH_TITLE="TaxiGo Verification"
TAXIGO_OTP_PUSH_BODY="Your login code: :code"
TAXIGO_OTP_TTL=300

# --- Payments ---
# stub (dev) | iyzico (Turkey)
TAXIGO_PAYMENT_DRIVER=stub
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

TAXIGO_CURRENCY=TRY
TAXIGO_COMMISSION_RATE=0.15
TAXIGO_RIDE_EXPIRY_MINUTES=15
TAXIGO_MATCHING_RADIUS_KM=5

# Force HTTPS redirects + HSTS (auto true when APP_ENV=production)
TAXIGO_FORCE_HTTPS=false

# --- Production checklist ---
# 1) APP_ENV=production APP_DEBUG=false APP_URL=https://...
# 2) TAXIGO_DEMO_LOGIN=false + Super Admin modules → demo_login off
# 3) TAXIGO_SMS_DRIVER=whatsapp + Twilio WhatsApp sender
# 4) FIREBASE_DATABASE_URL set + `php artisan taxigo:firebase-rules --deploy`
# 5) Cron / Task Scheduler: deploy/run-scheduler.ps1 or deploy/crontab.example
# 6) php artisan taxigo:prod-check
